# Django Production Environment Configuration Example
# Copy this file to .env and configure for your production deployment

# Set to False in production
DEBUG=False

# Generate a 50+ character random secret string for production
SECRET_KEY=django-insecure-replace-with-a-strong-random-key-in-production-123456789

# Comma-separated list of hostnames/domains permitted to serve the app
ALLOWED_HOSTS=127.0.0.1,localhost,yourdomain.com

# Comma-separated allowed CORS origins for your frontend
CORS_ALLOWED_ORIGINS=http://localhost:5173,https://yourdomain.com

# Email / Mailer Settings
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=Bloggin Platform <your-email@gmail.com>
FRONTEND_URL=http://localhost:5173

